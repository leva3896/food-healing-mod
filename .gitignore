# Ignore output and build directories
/build/
/out/
/run/
/run-data/

# Ignore Gradle caches and daemons
.gradle/
gradle-app.setting

# Ignore IDE directories and files
/.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
bin/

# Eclipse
*.launch

# macOS
.DS_Store

# Ignore generated resources
/src/generated/
libs/

tmp_monolith/

# Local evidence, external reference MODs, runtimes and release binaries
/libs/
/tmp_monolith/
/backups/
/logs/
/release/**/*.jar
*.log

# Private local evidence, launchers, credential stores, and Python bytecode
/crash-reports/
/screenshots/
/verification/
/runtime/
/runtimes/
/.privacy-local/
__pycache__/
*.py[cod]
.env
.env.*
.git-credentials
accounts.json
credentials.json
credentials.db
id_rsa
id_ed25519
*.p12
*.pfx
